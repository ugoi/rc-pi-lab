#!/bin/sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /run
mount -t tmpfs -o size=32m,mode=1777 tmpfs /tmp
# The stateless control app must not contend with emulated SD writeback.
root_options=$(awk '$2 == "/" {print $4}' /proc/mounts)
case ",$root_options," in
 *,ro,*) echo M3_ROOT_MODE_RO ;;
 *) echo M3_CONFIG_ERROR_ROOT_NOT_READONLY; exit 2 ;;
esac
export PYTHONDONTWRITEBYTECODE=1
# lgpio creates its notification FIFO in cwd even for Blinka's I2C setup.
mkdir -p /run/rc-control || exit 3
cd /run/rc-control || exit 3
echo M3_WORKDIR_TMPFS_RUN_RC_CONTROL
modprobe i2c-bcm2835
modprobe i2c-dev
export PYTHONPATH=/opt/rc-lab/packages
echo M3_AUDIT_START
case " $(cat /proc/cmdline) " in
 *" m3.reuse_audit=1 "*) echo M3_AUDIT_REUSED_IMMUTABLE_BASE ;;
 *) python3 -u /opt/rc-lab/verify_packages.py || exit 1 ;;
esac
export M3_TESTING=0
case " $(cat /proc/cmdline) " in
 *" m3.test_faults=1 "*) export M3_TESTING=1 ;;
esac
python3 -u /opt/rc-lab/guest_control.py </dev/ttyAMA0 >/dev/ttyAMA0 2>&1
echo "M3_APP_EXIT code=$?"
# Keep Linux alive after deliberate app crash. No auto restart/re-arm.
echo M3_IDLE_INIT
while :; do sleep 3600; done
